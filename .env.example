# Data layer: "memory" (dev/demo only, does not persist across cold starts)
# or "supabase" (required in every production deployment, see README).
DATA_STORE=memory

# Supabase (required when DATA_STORE=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Calendar/Meet providers — both P0 per PRD §20 (CEO directive).
# OAuth wiring is stubbed in this scaffold; see src/lib/calendar/*.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
