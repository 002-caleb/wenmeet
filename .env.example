# Data layer: "memory" (dev/demo only, does not persist across cold starts)
# or "netlify" (Netlify Database — required in every production
# deployment, see README and netlify.toml).
DATA_STORE=memory

# Netlify Database — no manual connection string needed. Netlify injects
# NETLIFY_DB_URL automatically for Functions/builds once the database is
# provisioned (see `netlify database status`). Only set NETLIFY_DB_URL
# yourself if running outside Netlify's runtime (e.g. a one-off script).
# NETLIFY_DB_URL=

# Calendar/Meet providers — both P0. See src/lib/calendar/*.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Pre-release notice. "true" renders the site-wide WIP banner; anything
# else (or unset) hides it. Set to false at launch — no code change needed.
NEXT_PUBLIC_WIP_MODE=true
# Optional override for the banner wording.
# NEXT_PUBLIC_SITE_NOTICE="WIP · Under construction"
